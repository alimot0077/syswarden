[Unit]
Description=SysWarden background watcher (detects abandoned and runaway processes, heat and low memory)
Documentation=https://github.com/alimot0077/syswarden
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @APPDIR@/main.py --watch
Nice=10
Restart=on-failure
RestartSec=10
MemoryMax=150M
CPUQuota=10%

[Install]
WantedBy=default.target
